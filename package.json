{
  "name": "lightmetal",
  "version": "0.5.0",
  "description": "ligHTMetaL: local-first HTML and Markdown editors plus a Markdown parser. Zero runtime dependencies.",
  "main": "dist/lightmetal.js",
  "module": "dist/lightmetal.esm.js",
  "files": [
    "dist",
    "src",
    "ligHTMetaL.png",
    "README.md",
    "CHANGELOG.md",
    "docs/MeltDown.md"
  ],
  "scripts": {
    "build": "bash build/build.sh",
    "test": "npm run build && NODE_PATH=$(npm root -g) node tests/smoke.js && npm run test:meltdown && npm run test:markdown && npm run test:security",
    "test:meltdown": "node --test tests/meltdown/*.test.js",
    "test:markdown": "NODE_PATH=$(npm root -g) node tests/markdown.js",
    "test:package": "NODE_PATH=$(npm root -g) node tests/package-smoke.js",
    "test:security": "NODE_PATH=$(npm root -g) node tests/security-review.js"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "html",
    "markdown",
    "parser",
    "local-first",
    "pell"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0"
  }
}
