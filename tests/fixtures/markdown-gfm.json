{
  "standard": "CommonMark 0.31.2",
  "extensions": "GFM 0.29-gfm (2019-04-06), selected extensions",
  "description": "Original strike, task, table, and bare-autolink source fixtures. No renderer or interactive controls.",
  "cases": [
    { "name": "Unresolved brackets retain underscore URL boundaries", "markdown": "[ prefix_www.example.invalid/path ]", "headings": [0], "link": ["www.example.invalid/path"] },
    { "name": "Unresolved brackets protect backticks in a URL path", "markdown": "[ www.example.invalid/x`code`/tail ]", "headings": [0], "link": ["www.example.invalid/x`code`/tail"] },
    { "name": "Unresolved brackets protect emphasis in a URL path", "markdown": "[ www.example.invalid/x*metal*/tail ]", "headings": [0], "link": ["www.example.invalid/x*metal*/tail"] },
    { "name": "Unclosed brackets protect strike in a URL path", "markdown": "[ www.example.invalid/x~~metal~~/tail", "headings": [0], "link": ["www.example.invalid/x~~metal~~/tail"] },
    { "name": "Successful labels retain Markdown inside URL-looking text", "markdown": "[ www.example.invalid/x`code`/tail ](local)", "headings": [0], "marker": ["[", "`", "`", "](", ")"], "link": [" www.example.invalid/x", "code", "/tail "], "code": ["code"], "url": ["local"] },
    { "name": "Reference labels retain Markdown inside URL-looking text", "markdown": "[ www.example.invalid/x`code`/tail ][ref]\n\n[ref]: /local", "headings": [0, 0, 0], "marker": ["[", "`", "`", "][ref]", "[ref]: "], "link": [" www.example.invalid/x", "code", "/tail "], "code": ["code"], "url": ["/local"] },
    { "name": "Image labels retain Markdown inside URL-looking text", "markdown": "![ www.example.invalid/x*metal*/tail ](image)", "headings": [0], "marker": ["![", "*", "*", "](", ")"], "link": [" www.example.invalid/x", "metal", "/tail "], "italic": ["metal"], "url": ["image"] },
    { "name": "A deferred bare URL preserves a resolved sibling label", "markdown": "[ [metal](local) www.example.invalid/x*metal*/tail ]", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal", "www.example.invalid/x*metal*/tail"], "url": ["local"] },
    { "name": "Cached host checks preserve later valid URL suffixes", "markdown": "www.._www.example.invalid", "headings": [0], "link": ["www.example.invalid"] },
    { "name": "Repeated empty domain segments stay invalid", "markdown": "www..www.example.invalid", "headings": [0] },
    { "name": "Bare links and resolved references share a paragraph", "markdown": "[ www.example.invalid/x`code`/tail ] [metal]\n\n[metal]: /local", "headings": [0, 0, 0], "marker": ["[", "]", "[metal]: "], "link": ["www.example.invalid/x`code`/tail", "metal"], "url": ["/local"] },
    { "name": "Mixed single and double strike", "markdown": "~warm~ and ~~metal~~", "headings": [0], "marker": ["~", "~", "~~", "~~"], "strike": ["warm", "metal"] },
    { "name": "Strike requires matching whole runs", "markdown": "~warm~~\n\n~~metal~", "headings": [0, 0, 0] },
    { "name": "Strike can contain nested emphasis", "markdown": "~**metal**~", "headings": [0], "marker": ["~**", "**~"], "bold": ["metal"], "strike": ["metal"] },
    { "name": "Strike can span soft lines", "markdown": "~~warm\nmetal~~", "headings": [0, 0], "marker": ["~~", "~~"], "strike": ["warm", "metal"] },
    { "name": "Strike does not cross blank lines", "markdown": "~~warm\n\nmetal~~", "headings": [0, 0, 0] },
    { "name": "Escaped tildes remain literal", "markdown": "\\~metal\\~", "headings": [0] },
    { "name": "Strike labels and literal destinations", "markdown": "~~[metal](path~~literal)~~", "headings": [0], "marker": ["~~[", "](", ")~~"], "strike": ["metal"], "link": ["metal"], "url": ["path~~literal"] },
    { "name": "A link label scopes unmatched strike delimiters", "markdown": "~[metal~](local)", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal~"], "url": ["local"] },
    { "name": "Unchecked task marker", "markdown": "- [ ] **metal**", "headings": [0], "marker": ["- ", "[ ]", "**", "**"], "bold": ["metal"] },
    { "name": "Checked task markers preserve spelling", "markdown": "- [x] warm\n- [X] metal", "headings": [0, 0], "marker": ["- ", "[x]", "- ", "[X]"] },
    { "name": "Ordered tasks and nested tasks", "markdown": "1. [ ] warm\n   - [x] metal", "headings": [0, 0], "marker": ["1. ", "[ ]", "- ", "[x]"] },
    { "name": "Quoted tasks", "markdown": "> - [ ] metal", "headings": [0], "marker": ["> - ", "[ ]"] },
    { "name": "A standalone task-looking marker is plain", "markdown": "[ ] metal", "headings": [0] },
    { "name": "Later list paragraphs cannot become tasks", "markdown": "- first\n\n  [ ] later", "headings": [0, 0, 0], "marker": ["- "] },
    { "name": "Task markers require a content separator", "markdown": "- [x]metal", "headings": [0], "marker": ["- "] },
    { "name": "Invalid task marker content remains plain", "markdown": "- [y] metal\n- [  ] metal", "headings": [0, 0], "marker": ["- ", "- "] },
    { "name": "Task marker tabs remain source tabs", "markdown": "- [\t]\tmetal", "headings": [0], "marker": ["- ", "[\t]"] },
    { "name": "Empty task item is recognized", "markdown": "- [ ]", "headings": [0], "marker": ["- ", "[ ]"] },
    { "name": "Task-looking headings are not tasks", "markdown": "- # [ ] metal", "headings": [1], "marker": ["- ", "# "] },
    { "name": "Task-looking Setext headings are not tasks", "markdown": "- [ ] metal\n  ===", "headings": [1, 0], "marker": ["- ", "==="] },
    { "name": "A task paragraph can follow an empty list opening", "markdown": "-\n  [ ] metal", "headings": [0, 0], "marker": ["-", "[ ]"] },
    { "name": "Two-column table with inline formatting", "markdown": "| **warm** | metal |\n| --- | :---: |\n| a | b |", "headings": [0, 0, 0], "marker": ["|", "**", "**", "|", "|", "| --- | :---: |", "|", "|", "|"], "bold": ["warm"] },
    { "name": "Table boundaries need no outer pipes", "markdown": "warm | metal\n-- | --\na | b", "headings": [0, 0, 0], "marker": ["|", "-- | --", "|"] },
    { "name": "A table can interrupt an ordinary paragraph", "markdown": "body\nwarm | metal\n--- | ---", "headings": [0, 0, 0], "marker": ["|", "--- | ---"] },
    { "name": "Single-column pipe headers can precede a thematic-looking delimiter", "markdown": "| metal |\n---", "headings": [0, 0], "marker": ["|", "|", "---"] },
    { "name": "A bare single hyphen retains Setext precedence", "markdown": "| metal |\n-", "headings": [2, 0], "marker": ["-"] },
    { "name": "A header without a pipe does not form a table", "markdown": "metal\n| --- |", "headings": [0, 0] },
    { "name": "Mismatched header and delimiter cells reject tables", "markdown": "| warm | metal |\n| --- |", "headings": [0, 0] },
    { "name": "Escaped pipes stay within a cell", "markdown": "| warm\\|metal |\n| --- |\n| `a\\|b` |", "headings": [0, 0, 0], "marker": ["|", "|", "| --- |", "|", "`", "`", "|"], "code": ["a\\|b"] },
    { "name": "Unescaped pipes split code-looking table cells", "markdown": "| a | b |\n| --- | --- |\n| `warm|metal` |", "headings": [0, 0, 0], "marker": ["|", "|", "|", "| --- | --- |", "|", "|", "|"] },
    { "name": "Inline formatting cannot cross cell boundaries", "markdown": "| **warm | metal** |\n| --- | --- |", "headings": [0, 0], "marker": ["|", "|", "|", "| --- | --- |"] },
    { "name": "Excess table cells remain literal source", "markdown": "| a |\n| --- |\n| **warm** | **extra** |", "headings": [0, 0, 0], "marker": ["|", "|", "| --- |", "|", "**", "**", "|", "|"], "bold": ["warm"] },
    { "name": "A table body may omit pipes", "markdown": "| a | b |\n| --- | --- |\n**metal**", "headings": [0, 0, 0], "marker": ["|", "|", "|", "| --- | --- |", "**", "**"], "bold": ["metal"] },
    { "name": "A blank line ends a table", "markdown": "| metal |\n| --- |\n\n# after", "headings": [0, 0, 0, 1], "marker": ["|", "|", "| --- |", "# "] },
    { "name": "A heading ends a table without a blank line", "markdown": "| metal |\n| --- |\n# after", "headings": [0, 0, 1], "marker": ["|", "|", "| --- |", "# "] },
    { "name": "Quoted tables require quote prefixes", "markdown": "> | metal |\n> | --- |\n**after**", "headings": [0, 0, 0], "marker": ["> ", "|", "|", "> ", "| --- |", "**", "**"], "bold": ["after"] },
    { "name": "Table cells resolve document-wide reference links", "markdown": "| [metal] |\n| --- |\n\n[metal]: /local", "headings": [0, 0, 0, 0], "marker": ["|", "[", "]", "|", "| --- |", "[metal]: "], "link": ["metal"], "url": ["/local"] },
    { "name": "HTTP and www bare links", "markdown": "http://example.invalid www.example.invalid", "headings": [0], "link": ["http://example.invalid", "www.example.invalid"] },
    { "name": "Bare URL trailing punctuation stays outside", "markdown": "Visit https://example.invalid/path?!.,:*_~", "headings": [0], "link": ["https://example.invalid/path"] },
    { "name": "Only unmatched trailing parentheses leave a bare URL", "markdown": "(https://example.invalid/a(b)))", "headings": [0], "link": ["https://example.invalid/a(b)"] },
    { "name": "Interior unmatched parentheses remain in a bare URL", "markdown": "https://example.invalid/a))+tail", "headings": [0], "link": ["https://example.invalid/a))+tail"] },
    { "name": "Entity-looking bare URL suffixes remain outside", "markdown": "www.example.invalid/path&name;", "headings": [0], "link": ["www.example.invalid/path"] },
    { "name": "An angle bracket terminates a bare URL", "markdown": "www.example.invalid/he<lp", "headings": [0], "link": ["www.example.invalid/he"] },
    { "name": "Bare URL domains reject underscores in their last two segments", "markdown": "www.exa_mple.invalid www.example.in_valid", "headings": [0] },
    { "name": "Bare URL domains allow earlier underscores", "markdown": "https://sub_name.example.invalid/path", "headings": [0], "link": ["https://sub_name.example.invalid/path"] },
    { "name": "Bare URLs need a permitted left boundary", "markdown": "prefixhttps://example.invalid /www.example.invalid", "headings": [0] },
    { "name": "Bare URLs inherit surrounding emphasis", "markdown": "**https://example.invalid**", "headings": [0], "marker": ["**", "**"], "bold": ["https://example.invalid"], "link": ["https://example.invalid"] },
    { "name": "Bare URL paths protect interior Markdown", "markdown": "https://example.invalid/**warm**/tail", "headings": [0], "link": ["https://example.invalid/**warm**/tail"] },
    { "name": "Explicit links win over bare URL labels", "markdown": "[https://example.invalid](local)", "headings": [0], "marker": ["[", "](", ")"], "link": ["https://example.invalid"], "url": ["local"] },
    { "name": "Bare email addresses", "markdown": "warm+metal@example.invalid", "headings": [0], "link": ["warm+metal@example.invalid"] },
    { "name": "Bare email trailing periods stay outside", "markdown": "warm-metal@example.invalid.", "headings": [0], "link": ["warm-metal@example.invalid"] },
    { "name": "Invalid email domain endings remain plain", "markdown": "metal@example.invalid- metal@example.invalid_", "headings": [0] },
    { "name": "Plus signs are not email domain characters", "markdown": "metal@example+invalid.org", "headings": [0] },
    { "name": "Mailto and XMPP source protocols", "markdown": "mailto:metal@example.invalid xmpp:metal@example.invalid/resource@local.more", "headings": [0], "link": ["mailto:metal@example.invalid", "xmpp:metal@example.invalid/resource@local.more"] },
    { "name": "An XMPP resource ends at a second slash", "markdown": "xmpp:metal@example.invalid/one/two", "headings": [0], "link": ["xmpp:metal@example.invalid/one"] },
    { "name": "Code protects bare links", "markdown": "`https://example.invalid metal@example.invalid`", "headings": [0], "marker": ["`", "`"], "code": ["https://example.invalid metal@example.invalid"] },
    { "name": "HTML attributes protect bare links", "markdown": "body <x title='https://example.invalid metal@example.invalid'>", "headings": [0] },
    { "name": "Table cells support bare links", "markdown": "| www.example.invalid |\n| --- |\n| metal@example.invalid |", "headings": [0, 0, 0], "marker": ["|", "|", "| --- |", "|", "|"], "link": ["www.example.invalid", "metal@example.invalid"] }
  ]
}
