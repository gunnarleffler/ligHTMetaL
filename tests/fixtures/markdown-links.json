{
  "standard": "CommonMark 0.31.2",
  "description": "Original inline link/image cases. Source stays visible and inert; reference and HTML context are separate work.",
  "cases": [
    { "name": "Balanced parentheses belong to the destination", "markdown": "[metal](path(one(two(three))))", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal"], "url": ["path(one(two(three)))"] },
    { "name": "Escaped destination parentheses stay literal", "markdown": "[metal](path\\(one\\))", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal"], "url": ["path\\(one\\)"] },
    { "name": "Angle destinations permit spaces and unmatched parentheses", "markdown": "[metal](<local path(one>)", "headings": [0], "marker": ["[", "](<", ">)"], "link": ["metal"], "url": ["local path(one"] },
    { "name": "Double quoted titles are literal", "markdown": "[metal](local \"**title**\")", "headings": [0], "marker": ["[", "](", " \"", "\")"], "link": ["metal"], "url": ["local", "**title**"] },
    { "name": "Single quoted titles support escaped quotes", "markdown": "[metal](local 'it\\'s metal')", "headings": [0], "marker": ["[", "](", " '", "')"], "link": ["metal"], "url": ["local", "it\\'s metal"] },
    { "name": "Parenthesized titles support escaped parentheses", "markdown": "[metal](local (a\\(b\\)))", "headings": [0], "marker": ["[", "](", " (", "))"], "link": ["metal"], "url": ["local", "a\\(b\\)"] },
    { "name": "Empty labels and destinations still have markers", "markdown": "[]() [metal](<>)", "headings": [0], "marker": ["[]()", "[", "](<>)"], "link": ["metal"] },
    { "name": "A quoted destination cannot contain spaces", "markdown": "[metal]( \"a title\" )", "headings": [0] },
    { "name": "An explicitly empty destination permits a title", "markdown": "[metal](<> \"a title\")", "headings": [0], "marker": ["[", "](<> \"", "\")"], "link": ["metal"], "url": ["a title"] },
    { "name": "A quote without spaces can be a destination", "markdown": "[metal](\"title\")", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal"], "url": ["\"title\""] },
    { "name": "Balanced brackets stay visible inside labels", "markdown": "[warm [metal]](local)", "headings": [0], "marker": ["[", "](", ")"], "link": ["warm [metal]"], "url": ["local"] },
    { "name": "Escaped label brackets do not close the label", "markdown": "[warm \\] metal](local)", "headings": [0], "marker": ["[", "](", ")"], "link": ["warm \\] metal"], "url": ["local"] },
    { "name": "Emphasis inside a label is recognized", "markdown": "[**warm** *metal*](local)", "headings": [0], "marker": ["[**", "**", "*", "*](", ")"], "link": ["warm", " ", "metal"], "bold": ["warm"], "italic": ["metal"], "url": ["local"] },
    { "name": "Code in a label protects its closing bracket", "markdown": "[warm `]` metal](local)", "headings": [0], "marker": ["[", "`", "`", "](", ")"], "link": ["warm ", "]", " metal"], "code": ["]"], "url": ["local"] },
    { "name": "Enclosing emphasis applies to labels but not destinations", "markdown": "**[metal](local)**", "headings": [0], "marker": ["**[", "](", ")**"], "bold": ["metal"], "link": ["metal"], "url": ["local"] },
    { "name": "Label delimiters cannot close outside emphasis", "markdown": "*[metal*](local)", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal*"], "url": ["local"] },
    { "name": "Label delimiters cannot open outside emphasis", "markdown": "[*metal](local)*", "headings": [0], "marker": ["[", "](", ")"], "link": ["*metal"], "url": ["local"] },
    { "name": "Innermost links win over enclosing links", "markdown": "[outer [inner](one)](two)", "headings": [0], "marker": ["[", "](", ")"], "link": ["inner"], "url": ["one"] },
    { "name": "An image can be a link label", "markdown": "[![alt](image.png)](page)", "headings": [0], "marker": ["[![", "](", ")](", ")"], "link": ["alt"], "url": ["image.png", "page"] },
    { "name": "An image description can contain a link", "markdown": "![outer [inner](page)](image.png)", "headings": [0], "marker": ["![", "[", "](", ")](", ")"], "link": ["outer ", "inner"], "url": ["page", "image.png"] },
    { "name": "Image descriptions allow emphasis", "markdown": "![**metal**](image.png \"title\")", "headings": [0], "marker": ["![**", "**](", " \"", "\")"], "bold": ["metal"], "link": ["metal"], "url": ["image.png", "title"] },
    { "name": "Soft lines are permitted in labels and titles", "markdown": "[warm\nmetal](local \"first\nlast\")", "headings": [0, 0, 0], "marker": ["[", "](", " \"", "\")"], "link": ["warm", "metal"], "url": ["local", "first", "last"] },
    { "name": "One line ending can separate link components", "markdown": "[metal](\n local\n 'title'\n)", "headings": [0, 0, 0, 0], "marker": ["[", "](", " ", " '", "'", ")"], "link": ["metal"], "url": ["local", "title"] },
    { "name": "Space in a bare destination rejects the link", "markdown": "[metal](local path)", "headings": [0] },
    { "name": "Unbalanced bare parentheses reject the link", "markdown": "[metal](local(one)", "headings": [0] },
    { "name": "Unclosed angle destinations reject the link", "markdown": "[metal](<local)", "headings": [0] },
    { "name": "Unescaped nested angles reject the link", "markdown": "[metal](<a<b>)", "headings": [0] },
    { "name": "Titles require a separator after the destination", "markdown": "[metal](<local>\"title\")", "headings": [0] },
    { "name": "Unescaped nested title parentheses reject the link", "markdown": "[metal](local (a(b)))", "headings": [0] },
    { "name": "Control characters reject bare destinations", "markdown": "[metal](local\u000bpath)", "headings": [0] },
    { "name": "Nonbreaking spaces are not ASCII destination separators", "markdown": "[metal](local path)", "headings": [0], "marker": ["[", "](", ")"], "link": ["metal"], "url": ["local path"] },
    { "name": "An escaped opening bracket is not a link", "markdown": "\\[metal](local)", "headings": [0] },
    { "name": "Whitespace before the destination is not an inline link", "markdown": "[metal] (local)", "headings": [0] },
    { "name": "A blank line separates a label from its close", "markdown": "[warm\n\nmetal](local)", "headings": [0, 0, 0] },
    { "name": "A blank line stops a destination before it starts", "markdown": "[metal](\n \t\nlocal)", "headings": [0, 0, 0] },
    { "name": "A blank line stops a destination before its title", "markdown": "[metal](local\n \t\n\"title\")", "headings": [0, 0, 0] },
    { "name": "A blank line stops a title before the closing parenthesis", "markdown": "[metal](local \"title\"\n \t\n)", "headings": [0, 0, 0] },
    { "name": "A quoted blank line also stops link components", "markdown": "> [metal](local\n> \n> \"title\")", "headings": [0, 0, 0], "marker": ["> ", "> ", "> "] },
    { "name": "Inline code cannot create links", "markdown": "`[metal](local)`", "headings": [0], "marker": ["`", "`"], "code": ["[metal](local)"] },
    { "name": "Typed dangerous URLs remain inert source", "markdown": "![alt](https://example.invalid/image.png) [run](javascript:alert(1))", "headings": [0], "marker": ["![", "](", ")", "[", "](", ")"], "link": ["alt", "run"], "url": ["https://example.invalid/image.png", "javascript:alert(1)"] }
  ]
}
