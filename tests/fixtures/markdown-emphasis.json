{
  "standard": "CommonMark 0.31.2",
  "description": "Original source-preserving emphasis and escape cases. Link-label cases guard emphasis integration; strike cases follow the selected GFM rules.",
  "cases": [
    { "name": "Triple stars combine bold and italic", "markdown": "***metal***", "headings": [0], "marker": ["***", "***"], "bold": ["metal"], "italic": ["metal"] },
    { "name": "Triple underscores combine bold and italic", "markdown": "___metal___", "headings": [0], "marker": ["___", "___"], "bold": ["metal"], "italic": ["metal"] },
    { "name": "Italic inside bold shares its closing run", "markdown": "**warm *metal***", "headings": [0], "marker": ["**", "*", "***"], "bold": ["warm ", "metal"], "italic": ["metal"] },
    { "name": "Bold inside italic shares its closing run", "markdown": "*warm **metal***", "headings": [0], "marker": ["*", "**", "***"], "bold": ["metal"], "italic": ["warm ", "metal"] },
    { "name": "A shared opening run can close in stages", "markdown": "***metal** stays*", "headings": [0], "marker": ["***", "**", "*"], "bold": ["metal"], "italic": ["metal", " stays"] },
    { "name": "An excess opening star stays literal", "markdown": "**metal*", "headings": [0], "marker": ["*", "*"], "italic": ["metal"] },
    { "name": "An excess closing star stays literal", "markdown": "*metal**", "headings": [0], "marker": ["*", "*"], "italic": ["metal"] },
    { "name": "The rule of three prevents a premature close", "markdown": "a**b*c**d", "headings": [0], "marker": ["**", "**"], "bold": ["b*c"] },
    { "name": "A shared run can close bold and open italic", "markdown": "a**b***c*d", "headings": [0], "marker": ["**", "***", "*"], "bold": ["b"], "italic": ["c"] },
    { "name": "Crossing underscore delimiters cannot escape star emphasis", "markdown": "*warm _metal* cold_", "headings": [0], "marker": ["*", "*"], "italic": ["warm _metal"] },
    { "name": "Crossing star delimiters cannot escape underscore emphasis", "markdown": "_warm *metal_ cold*", "headings": [0], "marker": ["_", "_"], "italic": ["warm *metal"] },
    { "name": "Double underscores cannot emphasize within a word", "markdown": "word__metal__word", "headings": [0] },
    { "name": "Single underscores cannot emphasize within a word", "markdown": "word_metal_word", "headings": [0] },
    { "name": "Accented letters are word content at underscore boundaries", "markdown": "é_metal_é", "headings": [0] },
    { "name": "Combining marks are not punctuation boundaries", "markdown": "é_metal_é", "headings": [0] },
    { "name": "Astral symbols count as Unicode punctuation", "markdown": "🦊_metal_🦊", "headings": [0], "marker": ["_", "_"], "italic": ["metal"] },
    { "name": "Astral punctuation uses whole code points", "markdown": "𐄀_metal_𐄀", "headings": [0], "marker": ["_", "_"], "italic": ["metal"] },
    { "name": "Punctuation beside word-internal stars prevents flanking", "markdown": "a*\"metal\"*b", "headings": [0] },
    { "name": "Quoted stars can enclose a word", "markdown": "\"*metal*\"", "headings": [0], "marker": ["*", "*"], "italic": ["metal"] },
    { "name": "Stars can emphasize within words", "markdown": "a*metal*b", "headings": [0], "marker": ["*", "*"], "italic": ["metal"] },
    { "name": "Inline code inherits enclosing bold", "markdown": "**before `literal` after**", "headings": [0], "marker": ["**", "`", "`", "**"], "code": ["literal"], "bold": ["before ", "literal", " after"] },
    { "name": "Inline code inherits enclosing italic", "markdown": "*`literal`*", "headings": [0], "marker": ["*`", "`*"], "code": ["literal"], "italic": ["literal"] },
    { "name": "Code content does not supply emphasis delimiters", "markdown": "**`*literal*`**", "headings": [0], "marker": ["**`", "`**"], "code": ["*literal*"], "bold": ["*literal*"] },
    { "name": "Emphasis-looking code stays literal beside emphasis", "markdown": "`**literal**` *styled*", "headings": [0], "marker": ["`", "`", "*", "*"], "code": ["**literal**"], "italic": ["styled"] },
    { "name": "Escaped stars cannot open or close emphasis", "markdown": "\\*literal\\* and *styled*", "headings": [0], "marker": ["*", "*"], "italic": ["styled"] },
    { "name": "An escaped backslash does not escape the following star", "markdown": "\\\\*styled*", "headings": [0], "marker": ["*", "*"], "italic": ["styled"] },
    { "name": "An escaped underscore stays visible inside emphasis", "markdown": "_metal\\_work_", "headings": [0], "marker": ["_", "_"], "italic": ["metal\\_work"] },
    { "name": "BOM is not CommonMark delimiter whitespace", "markdown": "*metal﻿*", "headings": [0], "marker": ["*", "*"], "italic": ["metal﻿"] },
    { "name": "NBSP is CommonMark delimiter whitespace", "markdown": "*metal *", "headings": [0] },
    { "name": "Vertical tab is not CommonMark delimiter whitespace", "markdown": "*metal\u000b*", "headings": [0], "marker": ["*", "*"], "italic": ["metal\u000b"] },
    { "name": "Emphasis can cross soft paragraph lines", "markdown": "*warm\nmetal*", "headings": [0, 0], "marker": ["*", "*"], "italic": ["warm", "metal"] },
    { "name": "Emphasis cannot cross blank paragraph boundaries", "markdown": "**warm\n\nmetal**", "headings": [0, 0, 0] },
    { "name": "Hard-break backslashes stay visible inside emphasis", "markdown": "**first\\\nlast**", "headings": [0, 0], "marker": ["**", "**"], "bold": ["first\\", "last"] },
    { "name": "Combined emphasis inside a quoted list", "markdown": "> - ***metal***", "headings": [0], "marker": ["> - ", "***", "***"], "bold": ["metal"], "italic": ["metal"] },
    { "name": "Combined emphasis inside a heading", "markdown": "## ***metal***", "headings": [2], "marker": ["## ", "***", "***"], "bold": ["metal"], "italic": ["metal"] },
    { "name": "Double-tilde strike is recognized", "markdown": "Keep ~~strike~~.", "headings": [0], "marker": ["~~", "~~"], "strike": ["strike"] },
    { "name": "Single tildes recognize strike", "markdown": "Keep ~plain~.", "headings": [0], "marker": ["~", "~"], "strike": ["plain"] },
    { "name": "Three or more inline tildes stay literal", "markdown": "Keep ~~~strike~~~.", "headings": [0] },
    { "name": "Link labels permit bold while URLs stay literal", "markdown": "[**label**](https://example.invalid/a)", "headings": [0], "marker": ["[**", "**](", ")"], "link": ["label"], "bold": ["label"], "url": ["https://example.invalid/a"] },
    { "name": "Link labels inherit enclosing bold", "markdown": "**[label](local)**", "headings": [0], "marker": ["**[", "](", ")**"], "link": ["label"], "bold": ["label"], "url": ["local"] },
    { "name": "Strike permits nested bold", "markdown": "~~**metal**~~", "headings": [0], "marker": ["~~**", "**~~"], "bold": ["metal"], "strike": ["metal"] },
    { "name": "Strike inherits surrounding bold", "markdown": "**~~metal~~**", "headings": [0], "marker": ["**~~", "~~**"], "bold": ["metal"], "strike": ["metal"] },
    { "name": "Code keeps its existing style inside strike", "markdown": "~~`literal`~~", "headings": [0], "marker": ["~~`", "`~~"], "code": ["literal"] }
  ]
}
