{
  "standard": "CommonMark 0.31.2",
  "description": "HTML context and angle-bracket autolinks. All HTML and URLs stay visible and inert.",
  "cases": [
    { "name": "Raw blocks accept a different case-insensitive closing tag", "markdown": "<ScRiPt>\n# literal\n\n**literal**\n</STYLE>\n# after", "headings": [0, 0, 0, 0, 0, 1], "marker": ["# "] },
    { "name": "Comments continue across blank lines until their terminator", "markdown": "<!--\n**literal**\n\n# literal\n--> **literal**\n**after**", "headings": [0, 0, 0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Processing instructions suppress Markdown until closing", "markdown": "<?tool\n[metal](local)\n?>\n**after**", "headings": [0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Declarations close at the first greater-than sign", "markdown": "<!DOCTYPE\n**literal**>\n**after**", "headings": [0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "CDATA contents remain literal", "markdown": "<![CDATA[\n# literal\n]]>\n**after**", "headings": [0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Known block tags end at blank lines not closing tags", "markdown": "<div>\n</div>\n**literal**\n\n**after**", "headings": [0, 0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Nested raw tags do not change a block's termination rule", "markdown": "<table>\n<pre>\n**literal**\n\n**after**", "headings": [0, 0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Complete custom tags can begin literal blocks", "markdown": "<local-widget title='metal'>\n**literal**\n\n**after**", "headings": [0, 0, 0, 0], "marker": ["**", "**"], "bold": ["after"] },
    { "name": "Custom closing tags can begin literal blocks", "markdown": "</local-widget>\n**literal**", "headings": [0, 0] },
    { "name": "Custom tags cannot interrupt ordinary paragraphs", "markdown": "body\n<local-widget>\n**metal**", "headings": [0, 0, 0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "Block tags can interrupt ordinary paragraphs", "markdown": "body\n<div>\n**literal**", "headings": [0, 0, 0] },
    { "name": "Custom tag trailing text prevents a literal block", "markdown": "<local-widget> **metal**", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "Definition-only paragraphs allow custom HTML blocks", "markdown": "[ref]: /local\n<local-widget>\n**literal**", "headings": [0, 0, 0], "marker": ["[ref]: "], "url": ["/local"] },
    { "name": "Missing quote prefixes close HTML context", "markdown": "> <script>\n> **literal**\n**after**", "headings": [0, 0, 0], "marker": ["> ", "> ", "**", "**"], "bold": ["after"] },
    { "name": "Missing list indentation closes HTML context", "markdown": "- <div>\n  **literal**\n**after**", "headings": [0, 0, 0], "marker": ["- ", "**", "**"], "bold": ["after"] },
    { "name": "Container-looking text inside HTML stays literal", "markdown": "<div>\n> **literal**\n- **literal**\n```\n# literal", "headings": [0, 0, 0, 0, 0] },
    { "name": "References inside HTML do not define labels", "markdown": "<!--\n[ref]: /local\n-->\n[ref]", "headings": [0, 0, 0, 0] },
    { "name": "Indented HTML remains code", "markdown": "    <div>\n    **literal**", "headings": [0, 0], "code": ["    <div>", "    **literal**"] },
    { "name": "Fenced HTML remains code", "markdown": "```\n<div>\n**literal**\n```", "headings": [0, 0, 0, 0], "marker": ["```", "```"], "code": ["<div>", "**literal**"] },
    { "name": "Inline attributes protect Markdown and reference brackets", "markdown": "before <x title=\"**literal** [ref]\"> **metal** </x>\n\n[ref]: /local", "headings": [0, 0, 0], "marker": ["**", "**", "[ref]: "], "bold": ["metal"], "url": ["/local"] },
    { "name": "Inline tags do not suppress Markdown between tags", "markdown": "<em>**metal**</em>", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "HTML source stays unstyled inside emphasis", "markdown": "**<x title=metal>metal</x>**", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "HTML source stays unstyled inside strike", "markdown": "~~<x title=metal>metal</x>~~", "headings": [0], "marker": ["~~", "~~"], "strike": ["metal"] },
    { "name": "Inline comments protect emphasis-looking source", "markdown": "body <!-- **literal** --> **metal**", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "Inline comments allow the short CommonMark forms", "markdown": "body <!--> <!---> **metal**", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "Incomplete inline tags stay ordinary Markdown", "markdown": "body <x title=\" **metal**", "headings": [0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "HTML attributes support a soft line ending", "markdown": "body <x\n title=\"**literal**\"> **metal**", "headings": [0, 0], "marker": ["**", "**"], "bold": ["metal"] },
    { "name": "URI autolinks protect emphasis and brackets", "markdown": "<https://example.invalid/**metal**?q=[ref]>", "headings": [0], "marker": ["<", ">"], "link": ["https://example.invalid/**metal**?q=[ref]"] },
    { "name": "Email autolinks protect underscore delimiters", "markdown": "<warm_metal@example.invalid>", "headings": [0], "marker": ["<", ">"], "link": ["warm_metal@example.invalid"] },
    { "name": "Autolinks prevent enclosing links", "markdown": "[outer <https://example.invalid>](local)", "headings": [0], "marker": ["<", ">"], "link": ["https://example.invalid"] },
    { "name": "Autolinks are allowed inside image labels", "markdown": "![<https://example.invalid>](image)", "headings": [0], "marker": ["![<", ">](", ")"], "link": ["https://example.invalid"], "url": ["image"] },
    { "name": "Enclosing emphasis applies to autolink labels", "markdown": "**<https://example.invalid>**", "headings": [0], "marker": ["**<", ">**"], "bold": ["https://example.invalid"], "link": ["https://example.invalid"] },
    { "name": "Typed executable-looking autolinks remain inert", "markdown": "<javascript:alert(1)>", "headings": [0], "marker": ["<", ">"], "link": ["javascript:alert(1)"] },
    { "name": "Autolinks do not process backslash escapes", "markdown": "<https://example.invalid/\\*metal\\*>", "headings": [0], "marker": ["<", ">"], "link": ["https://example.invalid/\\*metal\\*"] },
    { "name": "DEL is an ASCII control and rejects URI autolinks", "markdown": "<ab:has\u007fcontrol>", "headings": [0] },
    { "name": "Whitespace rejects URI autolinks", "markdown": "<https://example.invalid/warm metal>", "headings": [0] },
    { "name": "One-character schemes are not CommonMark autolinks", "markdown": "<x:metal>", "headings": [0] },
    { "name": "Escaped angle brackets cannot start autolinks", "markdown": "\\<https://example.invalid>", "headings": [0] },
    { "name": "Code protects HTML and autolinks", "markdown": "`<x> <https://example.invalid>`", "headings": [0], "marker": ["`", "`"], "code": ["<x> <https://example.invalid>"] },
    { "name": "Autolink precedence protects reference-looking suffixes", "markdown": "[foo<https://example.com/?search=][ref]>\n\n[ref]: /uri", "headings": [0, 0, 0], "marker": ["<", ">", "[ref]: "], "link": ["https://example.com/?search=][ref]"], "url": ["/uri"] },
    { "name": "Self-closing raw tag names do not start type-seven blocks", "markdown": "<pre/>\n**metal**", "headings": [0, 0], "marker": ["**", "**"], "bold": ["metal"] }
  ]
}
